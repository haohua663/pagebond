# 服务端平台密钥。浏览器只打 /api/...，不会拿到钥匙。
# 本地：复制为 .env.local 后填写。不要提交真实密钥。
# 兼容任何 OpenAI Chat Completions 网关。

# --- 双模型路由（推荐）---
# 日常（改稿人话化、润色、关键词、框架等）→ Qwen3.7-Plus；思考模式默认关。
QWEN_API_KEY=
# 默认阿里云百炼 OpenAI 兼容根（北京公共域）。可按地域改成 dashscope-intl 或专属域名。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认钉住快照；可改成 qwen3.7-plus 或其他标识。
QWEN_MODEL=qwen3.7-plus-2026-05-26

# 深度可选（诊断、当前稿分析 /「深度分析」）→ DeepSeek-V4-Pro。
# 只配 Qwen 也能跑日常；只配 DeepSeek 也能跑诊断/分析。缺哪条路由用哪把钥匙时会返回明确 NO_KEY。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# Thinking/reasoning is OFF by default for both routes (DeepSeek V4.x otherwise reasons at effort
# "high": diagnose/analyze ~30-43s instead of ~7-13s). Set to "on" to trade speed for depth.
# PAGEBOND_DEEP_THINKING=on
# PAGEBOND_DAILY_THINKING=on

# --- 通用 / 旧版单钥匙（任一路由缺专用钥匙时回退到这里）---
LLM_API_KEY=
# 兼容旧名：若未设置 LLM_API_KEY，仍可读 OPENROUTER_API_KEY。
# OPENROUTER_API_KEY=

# 可选。OpenAI 兼容 API 根路径（不含 /chat/completions）。
# 默认 https://openrouter.ai/api/v1（仅 LLM_* 回退路径）
# LLM_BASE_URL=

# 可选。服务端默认模型；请求体里的 model 优先。回退路径默认 qwen3.7-plus-2026-05-26
# LLM_MODEL=

# 可选。不填也能检索 OpenAlex，只是匿名额度更紧。
OPENALEX_API_KEY=

# --- 平台密钥的访客日额度与轻量防刷（仅对服务端平台密钥计费；用户自带密钥 BYOK 不占日额度）---
# 每访客每日模型请求次数上限（上海时区日历日）。默认 20。
PAGEBOND_DAILY_REQUEST_LIMIT=20

# 每访客每日 token（prompt+completion）软上限。默认 200000；设为 0 关闭。
PAGEBOND_DAILY_TOKEN_LIMIT=200000

# 每访客+IP 每分钟模型路由请求上限。默认 12。
PAGEBOND_RATE_LIMIT_PER_MINUTE=12


# --- Postgres 存档镜像（可选）---
# IndexedDB 仍是本机主存；配置后双写并支持服务端搜索。
# Docker: docker compose up -d
# 然后: npx drizzle-kit push
DATABASE_URL=postgresql://pagebond:pagebond@127.0.0.1:5432/pagebond

# --- 出图（可选；绘图「出图」按钮）---
# OpenRouter Images：IMAGE_API_KEY=sk-or-... 或沿用 OPENROUTER_API_KEY / LLM_API_KEY(sk-or-)
# IMAGE_API_KEY=
# IMAGE_API_URL=https://openrouter.ai/api/v1/images
# IMAGE_MODEL=openai/gpt-image-2
# 其他 OpenAI 兼容 Images：IMAGE_API_URL=https://api.example.com/v1/images/generations
